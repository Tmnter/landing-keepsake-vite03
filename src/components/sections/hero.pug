section.hero#top(aria-labelledby='hero-title')
  .container.hero__inner
    .hero__content
      h1#hero-title.hero__title Зберігаємо моменти, що мають значення
      p.hero__text Keepsake створює візуальні історії для весіль, родин та подорожей. Кожен кадр — маленька пам’ять, яку варто зберегти.
      a.button(href='#contact') Замовити зйомку
    .hero__media
      +picture('hero', 'Фотографія з портфоліо Keepsake', 1200, 900, { lazy: false, sizes: '(min-width: 1024px) 50vw, 100vw' })
